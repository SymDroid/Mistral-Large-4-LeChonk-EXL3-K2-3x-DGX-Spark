diff --git a/exllamav3/modules/linear.py b/exllamav3/modules/linear.py
index e3616aa..edf2a1d 100644
--- a/exllamav3/modules/linear.py
+++ b/exllamav3/modules/linear.py
@@ -400,9 +400,27 @@ class Linear(Module):
             return stc.get_tensor(k, device, optional = True, **kwargs) if stc.has_tensor(k) else None
         scale = None  # opt(".scale", self.device)
         su = opt(".su", self.device, no_defer = True)
-        suh = opt(".suh", self.device)
+        suh = opt(".suh", self.device, no_defer = True)
         sv = opt(".sv", self.device, no_defer = True)
-        svh = opt(".svh", self.device)
+        svh = opt(".svh", self.device, no_defer = True)
+
+        # FP16-backed Linear loads bake weight_scale into the weight tensor.
+        # EXL3 kernels bypass Linear.forward() in several BC/MoE paths, so the
+        # equivalent scale must be represented in the packed projection itself.
+        #
+        # svh is the multiplicative output scale applied after the EXL3
+        # reconstruction/Hadamard transform. Scaling it is therefore exactly
+        # equivalent to scaling the reconstructed weight/output, and is visible
+        # to LinearEXL3, BC_LinearEXL3 and the fused MoE kernels alike.
+        if self.weight_scale != 1.0:
+            if svh is None:
+                raise RuntimeError(
+                    f"EXL3 weight_scale={self.weight_scale} for {key}, "
+                    "but checkpoint stores packed .sv rather than .svh; "
+                    "packed-sv scaling is not implemented yet."
+                )
+            svh = (svh.float() * self.weight_scale).to(svh.dtype)
+
         trellis = stc.get_tensor(key + ".trellis", self.device)
         mcg = opt(".mcg", "cpu")
         mul1 = opt(".mul1", "cpu")
